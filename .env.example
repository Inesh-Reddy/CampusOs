# CampusOS environment (copy values into your shell or a local .env you never commit)
# Production: MySQL 8
# DB_URL=jdbc:mysql://127.0.0.1:3306/campusos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=campusos
# DB_PASSWORD=change-me
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# Local fallback (default when unset): H2 file database, no server needed
PORT=8080
CAMPUS_TIMEZONE=Asia/Kolkata
